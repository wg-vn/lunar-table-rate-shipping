{
    "name": "wg-vn/lunar-table-rate-shipping",
    "description": "Lunar's table rate shipping add-on for the Inertia panel (lunarphp/panel 2.x), without Filament. Forked from lunarphp/table-rate-shipping.",
    "keywords": [
        "lunar",
        "laravel",
        "ecommerce",
        "e-commerce",
        "headless",
        "store",
        "shop",
        "cart"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Lunar",
            "homepage": "https://lunarphp.io/"
        },
        {
            "name": "Vested Networks"
        }
    ],
    "autoload": {
        "psr-4": {
            "Lunar\\Shipping\\": "src",
            "Lunar\\Shipping\\Database\\Factories\\": "database/factories"
        }
    },
    "extra": {
        "lunar": {
            "name": "Table Rate Shipping"
        },
        "laravel": {
            "providers": [
                "Lunar\\Shipping\\ShippingServiceProvider"
            ]
        }
    },
    "require": {
        "php": "^8.4",
        "lunarphp/core": "2.0.0-alpha.6",
        "lunarphp/panel": "2.0.0-alpha.6"
    },
    "replace": {
        "lunarphp/table-rate-shipping": "self.version"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "laravel/pint": "^1.29"
    },
    "autoload-dev": {
        "psr-4": {
            "Lunar\\Tests\\Shipping\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest"
    },
    "minimum-stability": "alpha",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
